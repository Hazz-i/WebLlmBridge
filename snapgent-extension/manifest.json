{
  "manifest_version": 3,
  "name": "WebLlmBridge",
  "version": "1.0.0",
  "author": "Hazz-i <wahidh697@gmail.com>",
  "description": "Turn ChatGPT, Claude, DeepSeek, Gemini, Grok, Kimi, GLM, Qwen, Arena, Meta AI, Ptero or Mistral into an OpenAI-compatible API for Hermes Agent through a local bridge.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1/*",
    "https://claude.site/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebLlmBridge",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "providers/claude-intercept.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "providers/chatgpt-cm.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/chatgpt.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/claude.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/gemini.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.claudemcpcontent.com/*",
        "https://claude.site/*"
      ],
      "js": [
        "artifacts.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}